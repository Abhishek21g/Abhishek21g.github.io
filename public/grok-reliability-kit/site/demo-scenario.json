{
  "name": "offline-rag-contract",
  "description": "CI contract test for Grok Collections pipeline — no API keys. Validates probe → upload → index → search → multimodal resolve steps in mock mode.",
  "mode": "mock",
  "fixture_profile": "healthy",
  "expect": {
    "probes_healthy": true,
    "indexing_processed_min": 1,
    "search_succeeds": true,
    "rag_ready": true,
    "multimodal_paths_min": 1
  },
  "steps": [
    { "id": "probe", "action": "probe_channels" },
    { "id": "create", "action": "create_collection", "embedding_model": "grok-embedding-small" },
    {
      "id": "upload",
      "action": "upload_documents",
      "documents": [{ "name": "widget-a.txt", "text": "Red widget, glossy finish.", "fields": { "sku": "W-001" } }]
    },
    { "id": "index", "action": "wait_indexing" },
    { "id": "search", "action": "search", "query": "glossy red widget" },
    { "id": "multimodal", "action": "resolve_multimodal" },
    { "id": "chat", "action": "chat_ready" }
  ],
  "profiles": {
    "healthy": {
      "label": "Healthy pipeline",
      "subtitle": "All steps pass — collection is RAG-ready",
      "probes": {
        "overall": "healthy",
        "management_key_configured": true,
        "probes": [
          { "channel": "api", "check": "list_embedding_models", "status": "ok", "latency_ms": 120 },
          { "channel": "management", "check": "list_collections", "status": "ok", "latency_ms": 180 }
        ]
      },
      "indexing": {
        "total_sampled": 3,
        "processed": 3,
        "failed": 0,
        "in_flight": 0,
        "rag_ready": true,
        "rag_ready_ratio": 1.0,
        "counts": { "processed": 3, "failed": 0, "processing": 0, "chunked": 0, "embedding": 0, "writing": 0, "unknown": 0 },
        "failed_documents": [],
        "in_flight_documents": []
      },
      "search": { "status": "ok", "match_count": 2, "latency_ms": 95 },
      "multimodal_paths": ["/fixtures/images/widget-a.jpg"]
    },
    "degraded": {
      "label": "Indexing failures",
      "subtitle": "3 docs failed + 2 stuck — mirrors #77 pain",
      "probes": {
        "overall": "healthy",
        "management_key_configured": true,
        "probes": [
          { "channel": "api", "check": "list_embedding_models", "status": "ok", "latency_ms": 140 },
          { "channel": "management", "check": "list_collections", "status": "ok", "latency_ms": 210 }
        ]
      },
      "indexing": {
        "total_sampled": 10,
        "processed": 5,
        "failed": 3,
        "in_flight": 2,
        "rag_ready": false,
        "rag_ready_ratio": 0.5,
        "counts": { "processed": 5, "failed": 3, "processing": 1, "chunked": 1, "embedding": 0, "writing": 0, "unknown": 0 },
        "failed_documents": [
          { "file_id": "file-fail-1", "name": "bad-fields.txt", "error": "required field 'author' missing" }
        ],
        "in_flight_documents": [
          { "file_id": "file-stuck-1", "name": "large.pdf", "status": "embedding", "minutes_since_last_indexed": 42 }
        ]
      },
      "search": { "status": "ok", "match_count": 1, "latency_ms": 110 },
      "multimodal_paths": []
    },
    "backlog": {
      "label": "Backlog stall",
      "subtitle": "Nothing processed — search blocked",
      "probes": {
        "overall": "degraded",
        "management_key_configured": false,
        "probes": [
          { "channel": "api", "check": "list_embedding_models", "status": "ok", "latency_ms": 130 },
          {
            "channel": "management",
            "check": "list_collections",
            "status": "fail",
            "latency_ms": 50,
            "error": "management key not configured"
          }
        ]
      },
      "indexing": {
        "total_sampled": 8,
        "processed": 0,
        "failed": 0,
        "in_flight": 8,
        "rag_ready": false,
        "rag_ready_ratio": 0.0,
        "counts": { "processed": 0, "failed": 0, "processing": 3, "chunked": 2, "embedding": 2, "writing": 1, "unknown": 0 },
        "failed_documents": [],
        "in_flight_documents": []
      },
      "search": { "status": "fail", "match_count": 0, "latency_ms": 0, "error": "no processed documents" },
      "multimodal_paths": []
    }
  },
  "issue_refs": {
    "indexing_scaling": "https://github.com/xai-org/xai-sdk-python/issues/77",
    "sdk_pr": "https://github.com/xai-org/xai-sdk-python/pull/169"
  }
}
